<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="screensaver.matrix" name="Matrix" version="3.4.1" provider-name="jamal2362">
	<requires>
		<import addon="xbmc.python" version="3.0.0"/>
	</requires>
	<extension point="xbmc.ui.screensaver" library="resources/lib/entrypoints/screensaver_entry.py" />
	<extension point="xbmc.python.script" library="resources/lib/entrypoints/script_entry.py" />
	<extension point="xbmc.service" library="resources/lib/entrypoints/service_entry.py"/>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>MIT</license>
		<source>https://github.com/jamal2362/screensaver.matrix</source>
		<summary lang="en_GB">Matrix screensaver in Kodi</summary>
		<summary lang="de_DE">Matrix-Bildschirmschoner in Kodi</summary>
		<description lang="en_GB">The Matrix code rain, generated by the addon itself: no video files, no downloads and no network. Thirteen variants take turns.</description>
		<description lang="de_DE">Der Matrix-Code-Regen, vom Addon selbst erzeugt: ohne Videodateien, ohne Download und ohne Netzwerk. Dreizehn Varianten wechseln sich ab.</description>
		<assets>
			<icon>icon.jpg</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
