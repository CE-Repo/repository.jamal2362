<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.gronkhtv" name="Gronkh.tv" version="2.0.1" provider-name="jamal2362">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <language>de</language>
        <summary lang="en_GB">Watch videos from Gronkh.tv!</summary>
        <summary lang="de_DE">Schau dir Videos auf Gronkh.tv an!</summary>
        <description lang="en_GB">Gronkh.tv is an online video streaming service providing access to the stream archive of Gronkh and other Let's Players.</description>
        <description lang="de_DE">Gronkh.tv ist ein Online-Video-Streamingdienst, der Zugang zum Stream-Archiv von Gronkh und anderen Let's Playern bietet.</description>
        <license>MIT-License</license>
        <website>https://gronkh.tv/</website>
        <source>https://github.com/CE-Repo/plugin.video.gronkhtv</source>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>
