<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tinyppi" name="TinyPPI" version="1.5.5" provider-name="jamal2362">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="tools.tinyppi" version="1.0.0"/>
    </requires>
    <extension point="xbmc.service" library="resources/lib/monitor.py" />
    <extension point="xbmc.python.script" library="main.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>MIT-License</license>
        <source>https://github.com/CE-Repo/script.tinyppi</source>
        <summary lang="de">Zeigt benutzerdefinierte Prozessinformationen an</summary>
        <summary lang="en">Displays custom player process information</summary>
        <summary lang="zh">显示自定义播放器进程信息</summary>
        <description lang="de">Öffnet ein eigenes Prozessinformationen-Fenster. Dieses enthält Codec-, Video- und Audio-Details zum aktuell abgespielten Medium.</description>
        <description lang="en">Opens a separate process information window. This window displays codec, video, and audio details for the currently playing media.</description>
        <description lang="zh">打开一个独立的进程信息窗口。此窗口显示当前播放媒体的编解码器、视频和音频详细信息。</description>
        <assets>
            <icon>icon.jpg</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
