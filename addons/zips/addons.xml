    </requires>
    <extension point="xbmc.python.pluginsource" library="resources/lib/entry_point.py">
        <provides>video audio image</provides>
        <medialibraryscanpath content="movies">library/movies/</medialibraryscanpath>
        <medialibraryscanpath content="tvshows">library/tvshows/</medialibraryscanpath>
    </extension>
    <extension point="xbmc.service" library="resources/lib/service_entry_point.py" />
    <extension point="xbmc.python.script" library="resources/lib/entry_point.py" />
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <menu>
                <label>PyPlexer</label>
                <item library="resources/lib/context_actions/open_folder.py">
                    
                    <label>30840</label>
                    <visible>Window.IsVisible(home) + [!String.IsEmpty(ListItem.Property(PyPlexer.FolderUrl)) | !String.IsEmpty(ListItem.Property(PyPlexer.WatchlistRatingKey))]</visible>
                </item>
                <item library="resources/lib/context_actions/play_transcoded.py">
                    
                    <label>30086</label>
                    <visible>String.IsEqual(ListItem.Property(PyPlexer.CanTranscode),true) + [String.IsEqual(ListItem.DBTYPE,video) | String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode)]</visible>
                </item>
                <item library="resources/lib/context_actions/mark_watched.py">
                    
                    <label>30792</label>
                    <visible>String.IsEqual(ListItem.Property(PyPlexer.CanMarkWatched),true) + !String.IsEqual(ListItem.Property(PyPlexer.Watched),true) + [String.IsEqual(ListItem.DBTYPE,video) | String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.DBTYPE,episode)]</visible>
                </item>
                <item library="resources/lib/context_actions/mark_unwatched.py">
                    
                    <label>30793</label>
                    <visible>String.IsEqual(ListItem.Property(PyPlexer.CanMarkWatched),true) + String.IsEqual(ListItem.Property(PyPlexer.Watched),true) + [String.IsEqual(ListItem.DBTYPE,video) | String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.DBTYPE,episode)]</visible>
                </item>
                <item library="resources/lib/context_actions/remove_from_on_deck.py">
                    
                    <label>30854</label>
                    <visible>String.IsEqual(ListItem.Property(PyPlexer.OnDeck),true) + !String.IsEmpty(ListItem.Property(PyPlexer.MediaId)) + [String.IsEqual(ListItem.DBTYPE,video) | String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode)]</visible>
                </item>
                <item library="resources/lib/context_actions/add_to_watchlist.py">
                    
                    <label>30818</label>
                    <visible>!String.IsEmpty(ListItem.Property(PyPlexer.WatchlistRatingKey)) + !String.IsEqual(ListItem.Property(PyPlexer.Watchlisted),true) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
                </item>
                <item library="resources/lib/context_actions/remove_from_watchlist.py">
                    
                    <label>30819</label>
                    <visible>!String.IsEmpty(ListItem.Property(PyPlexer.WatchlistRatingKey)) + String.IsEqual(ListItem.Property(PyPlexer.Watchlisted),true) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
                </item>
                <item library="resources/lib/context_actions/toggle_external_watchlist.py">
                    
                    <label>30839</label>
                    <visible>String.IsEmpty(ListItem.Property(PyPlexer.WatchlistRatingKey)) + [!String.IsEmpty(ListItem.UniqueID(tmdb)) | !String.IsEmpty(ListItem.UniqueID(imdb)) | !String.IsEmpty(ListItem.UniqueID(tvdb)) | !String.IsEmpty(ListItem.Property(tmdb_id)) | !String.IsEmpty(ListItem.Property(imdb_id)) | !String.IsEmpty(ListItem.Property(tvdb_id)) | !String.IsEmpty(ListItem.Property(item.tmdb_id)) | !String.IsEmpty(ListItem.Property(item.imdb_id)) | !String.IsEmpty(ListItem.Property(item.tvdb_id)) | !String.IsEmpty(ListItem.Property(tmdb)) | !String.IsEmpty(ListItem.Property(imdb)) | !String.IsEmpty(ListItem.Property(tvdb)) | String.Contains(ListItem.FileNameAndPath,tmdb_id=) | String.Contains(ListItem.FileNameAndPath,imdb_id=) | String.Contains(ListItem.FileNameAndPath,tvdb_id=)] + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
                </item>
            </menu>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <source>https://github.com/CE-Repo/plugin.video.pyplexer</source>
        <summary lang="de">Wiedergabe von Videos, Musik und Fotos aus der Plex-Bibliothek</summary>
        <summary lang="en">Playback of videos, music, and photos from your Plex library</summary>
        <description lang="de">PyPlexer ist ein unabhängiges Drittanbieter-Addon für Plex und steht in keiner Verbindung zu Plex.</description>
        <description lang="en">PyPlexer is an independent third-party add-on for Plex and is not affiliated with Plex.</description>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
    </extension>
